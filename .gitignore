# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

docs
# production
/build
build*
!/baocao/evidence/build-output.txt

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# LaTeX build artifacts (keep report sources and PDF)
/baocao/*.aux
/baocao/*.fdb_latexmk
/baocao/*.fls
/baocao/*.log
/baocao/*.out
/baocao/*.synctex.gz
/baocao/*.toc

# agent skills (local config, not for version control)
.agents/
skills-lock.json
